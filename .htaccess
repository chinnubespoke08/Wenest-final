Options -MultiViews -Indexes
RewriteEngine On

# 0. Permanent Redirect legacy paths (AEO/SEO Preservation)
Redirect 301 /project-collection /projects
Redirect 301 /project-collection/ /projects/
# RedirectMatch 301 ^/blog(/.*)?$ /

# -------------------------------------------------------
# 1. Serve existing files directly (assets, _next, .html etc.)
# -------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# -------------------------------------------------------
# 2. 404 Fallback
# -------------------------------------------------------
ErrorDocument 404 /404.html

# -------------------------------------------------------
# 5. Cache static assets aggressively (performance)
# -------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 1 hour"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 month"
</IfModule>

# -------------------------------------------------------
# 6. Gzip compression
# -------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
